<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stammtisch Social Club | Location</title>
  <meta
    name="description"
    content="Location details for the Stammtisch Gentlemen's Assembly 2026."
  />

  <meta property="og:title" content="Stammtisch Social Club | Location" />
  <meta
    property="og:description"
    content="The 2026 Stammtisch Assembly shall convene in the mightly Huntsville."
  />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="stammtisch-crest.png" />

  <style>
    :root {
      --bg: #0e0b08;
      --bg-soft: #16110d;
      --panel: rgba(19, 14, 10, 0.88);
      --text: #f2e7d3;
      --text-soft: #d8c8ae;
      --accent: #c79d56;
      --accent-soft: rgba(199, 157, 86, 0.35);
      --border: rgba(199, 157, 86, 0.22);
      --shadow: rgba(0, 0, 0, 0.45);
      --max-width: 1100px;
      --radius: 18px;
      --nav-height: 84px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behaviour: smooth;
    }

    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at top, rgba(199, 157, 86, 0.08), transparent 35%),
        linear-gradient(180deg, #120d09 0%, #0c0907 100%);
      font-family: Georgia, "Times New Roman", Times, serif;
      line-height: 1.65;
      min-height: 100vh;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.08;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 3px,
          rgba(255, 255, 255, 0.02) 4px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 3px,
          rgba(255, 255, 255, 0.015) 4px
        );
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(10px);
      background: rgba(10, 7, 5, 0.9);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 24px;
      min-height: var(--nav-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand img {
      width: 54px;
      height: 54px;
      object-fit: contain;
      display: block;
    }

    .brand-text {
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-soft);
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
    }

    .nav-links a {
      position: relative;
      font-size: 0.95rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-soft);
      padding-bottom: 6px;
    }

    .nav-links a.active,
    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a.active::after,
    .nav-links a:hover::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--accent);
    }

    .page {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 56px 24px 72px;
      text-align: center;
    }

    .page-panel {
      background: linear-gradient(180deg, rgba(20, 14, 10, 0.92), rgba(12, 9, 7, 0.95));
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 40px 24px 52px;
      box-shadow: 0 24px 70px var(--shadow);
    }

    .crest-small {
      width: 84px;
      height: auto;
      display: block;
      margin: 0 auto 22px;
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 4.5vw, 4.6rem);
      line-height: 1.08;
      font-weight: 500;
    }

    .ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      margin: 18px auto 22px;
      color: var(--accent);
    }

    .ornament::before,
    .ornament::after {
      content: "";
      width: 110px;
      max-width: 20vw;
      height: 1px;
      background: var(--accent-soft);
    }

    .ornament span {
      font-size: 1rem;
      line-height: 1;
    }

    .intro {
      max-width: 820px;
      margin: 0 auto 30px;
      font-size: clamp(1.08rem, 1.8vw, 1.35rem);
      color: var(--text);
    }

    .map-wrap {
      width: 100%;
      max-width: 900px;
      margin: 0 auto 28px;
      border: 1px solid rgba(199, 157, 86, 0.45);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      background: rgba(255,255,255,0.04);
    }

    .map-wrap iframe {
      display: block;
      width: 100%;
      height: 500px;
      border: 0;
    }

    .button-row {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .button {
      display: inline-block;
      border: 1px solid var(--accent-soft);
      color: var(--text);
      padding: 14px 24px;
      border-radius: 999px;
      font-size: 0.95rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      background: rgba(199, 157, 86, 0.08);
    }

    .button:hover {
      transform: translateY(-1px);
      background: rgba(199, 157, 86, 0.14);
      border-color: rgba(199, 157, 86, 0.48);
    }

    .footer-note {
      margin-top: 30px;
      color: var(--accent);
      font-size: 1rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    @media (max-width: 860px) {
      .nav-inner {
        flex-direction: column;
        justify-content: center;
        padding-top: 14px;
        padding-bottom: 14px;
      }

      .brand {
        justify-content: center;
      }

      .brand-text {
        white-space: normal;
        text-align: center;
      }
    }

    @media (max-width: 700px) {
      .page {
        padding: 34px 16px 50px;
      }

      .page-panel {
        padding: 28px 18px 38px;
        border-radius: 22px;
      }

      .map-wrap iframe {
        height: 400px;
      }
    }

    @media (max-width: 520px) {
      .nav-links {
        justify-content: center;
        gap: 18px;
      }

      .nav-links a {
        font-size: 0.85rem;
      }

      .brand img {
        width: 46px;
        height: 46px;
      }

      .brand-text {
        font-size: 0.82rem;
      }

      .map-wrap iframe {
        height: 320px;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="nav-inner">
      <a class="brand" href="index.html">
        <img src="stammtisch-crest.png" alt="Stammtisch Social Club crest" />
        <div class="brand-text">The Stammtisch Social Club</div>
      </a>

      <nav class="nav-links" aria-label="Primary navigation">
        <a href="index.html">Home</a>
        <a href="location.html" class="active">Location</a>
      </nav>
    </div>
  </header>

  <main class="page">
    <section class="page-panel">
      <img
        class="crest-small"
        src="stammtisch-crest.png"
        alt="Stammtisch Social Club crest"
      />

      <h1>Stammtisch Gentlemen's Assembly 2026 - Location</h1>
      <div class="ornament"><span>✦</span></div>

      <p class="intro">
        The 2026 Stammtisch Assembly shall convene in the mightly Huntsville
      </p>

      <div class="map-wrap">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d1601.577490427999!2d-79.22810116411857!3d45.38110872683713!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2sca!4v1781281540472!5m2!1sen!2sca"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Map showing the location of the Stammtisch Gentlemen's Assembly">
        </iframe>
      </div>

      <div class="button-row">
        <a
          class="button"
          href="https://www.google.com/maps/search/?api=1&query=45.38110872683713,-79.22810116411857"
          target="_blank"
          rel="noopener"
        >
          Open in Google Maps
        </a>
      </div>

      <div class="footer-note">The Stammtisch Social Club</div>
    </section>
  </main>
</body>
</html>
